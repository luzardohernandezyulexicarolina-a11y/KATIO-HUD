local function round(obj)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,9)
    c.Parent = obj
end

local function register(obj, kind)
    table.insert(themedObjects, {object=obj, kind=kind})
end

local function outline(obj)
    local s = Instance.new("UIStroke")
    s.Color = accentColor
    s.Thickness = 1.5
    s.Parent = obj
    register(s, "stroke")
end

local function label(parent, text, height, fontSize)
    local l = Instance.new("TextLabel")
    l.Parent = parent
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(1,-8,0,height)
    l.Text = text
    l.TextColor3 = Color3.new(1,1,1)
    l.Font = Enum.Font.GothamBold
    l.TextSize = fontSize or 13
    l.TextWrapped = true
    l.LayoutOrder = 999
    return l
end

local function button(parent, text, height)
    local b = Instance.new("TextButton")
    b.Parent = parent
    b.Size = UDim2.new(1,-8,0,height or 36)
    b.BackgroundColor3 = cardColor
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.AutoButtonColor = true
    round(b)
    outline(b)
    register(b,"card")
    return b
end

local function textbox(parent, hint, height)
    local t = Instance.new("TextBox")
    t.Parent = parent
    t.Size = UDim2.new(1,-8,0,height or 36)
    t.BackgroundColor3 = cardColor
    t.TextColor3 = Color3.new(1,1,1)
    t.PlaceholderColor3 = Color3.fromRGB(180,170,190)
    t.PlaceholderText = hint
    t.Font = Enum.Font.Gotham
    t.TextSize = 13
    t.ClearTextOnFocus = false
    round(t)
    outline(t)
    register(t,"card")
    return t
end

local function makePanel(name, size, position)
    local f = Instance.new("Frame")
    f.Name = name
    f.Parent = gui
    f.Size = size
    f.Position = position
    f.BackgroundColor3 = mainColor
    f.BorderSizePixel = 0
    round(f)
    outline(f)
    register(f,"main")
    return f
end

local function makeDraggable(frame, handle)
    local dragging = false
    local startInput, startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPosition = frame.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - startInput
            frame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function applyTheme()
    local t = THEMES[themeIndex]
    mainColor, cardColor, accentColor = t.main, t.card, t.accent

    for _, item in ipairs(themedObjects) do
        local obj = item.object
        if obj and obj.Parent then
            if item.kind == "main" then
                obj.BackgroundColor3 = mainColor
            elseif item.kind == "card" then
                obj.BackgroundColor3 = cardColor
            elseif item.kind == "stroke" then
                obj.Color = accentColor
            end
        end
    end
end

