local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local OWNER_NAME = "MINIDELTAX8"
local ADMIN_NAME = "Lewis_t480"
local OWNER_KEY = "KATIO-GITHUB-OWNERR"

local remote = ReplicatedStorage:FindFirstChild("KATIO_Remote")
if not remote then
    remote = Instance.new("RemoteEvent")
    remote.Name = "KATIO_Remote"
    remote.Parent = ReplicatedStorage
end

local noclip = {}
local collisionSaved = {}
local transparencySaved = {}
local invincible = {}
local invisible = {}
local speedSaved = {}

local function getRole(player)
    if player.Name == OWNER_NAME then return "OWNER" end
    if player.Name == ADMIN_NAME then return "ADMIN" end
    return "USER"
end

local function isStaff(player)
    return getRole(player) ~= "USER"
end

local function getHumanoid(player)
    local character = player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function applyNoclip(player, enabled)
    local character = player.Character
    if not character then return end

    noclip[player] = enabled
    collisionSaved[player] = collisionSaved[player] or {}

    if enabled then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if collisionSaved[player][part] == nil then
                    collisionSaved[player][part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end
    else
        for part, oldValue in pairs(collisionSaved[player]) do
            if part and part.Parent then
                part.CanCollide = oldValue
            end
        end
        collisionSaved[player] = {}
    end
end

local function applyInvisible(player, enabled)
    local character = player.Character
    if not character then return end

    invisible[player] = enabled
    transparencySaved[player] = transparencySaved[player] or {}

    if enabled then
        for _, item in ipairs(character:GetDescendants()) do
            if item:IsA("BasePart") or item:IsA("Decal") then
                if transparencySaved[player][item] == nil then
                    transparencySaved[player][item] = item.Transparency
                end
                item.Transparency = 1
            end
        end
    else
        for item, oldValue in pairs(transparencySaved[player]) do
            if item and item.Parent then
                item.Transparency = oldValue
            end
        end
        transparencySaved[player] = {}
    end
end

local function applyInvincible(player, enabled)
    invincible[player] = enabled
    local character = player.Character
    if not character then return end

    local humanoid = getHumanoid(player)
    if not humanoid then return end

    local shield = character:FindFirstChild("KATIO_InvincibleShield")

    if enabled then
        humanoid.MaxHealth = 1000000000
        humanoid.Health = humanoid.MaxHealth

        if not shield then
            shield = Instance.new("ForceField")
            shield.Name = "KATIO_InvincibleShield"
            shield.Visible = true
            shield.Parent = character
        end
    else
        if shield then shield:Destroy() end
        humanoid.MaxHealth = 100
        humanoid.Health = math.min(humanoid.Health, 100)
    end
end

local function setupPlayer(player)
    player:SetAttribute("KATIO_Role", getRole(player))
    player:SetAttribute("KATIO_OwnerUnlocked", false)
    player:SetAttribute("KATIO_FlyEnabled", false)
    player:SetAttribute("KATIO_InfiniteJump", false)

    player.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if humanoid then
            humanoid.WalkSpeed = speedSaved[player] or 16
        end

        task.wait(0.2)

        if noclip[player] then
            applyNoclip(player, true)
        end
        if invisible[player] then
            applyInvisible(player, true)
        end
        if invincible[player] then
            applyInvincible(player, true)
        end
    end)
end

Players.PlayerAdded:Connect(setupPlayer)

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

remote.OnServerEvent:Connect(function(player, action, value)
    local role = getRole(player)

    -- CLIENT POWERS: disponibles para todos
    if action == "Speed" then
        local speed = tonumber(value)
        if not speed then return end

        speed = math.clamp(speed, 16, 100)
        speedSaved[player] = speed

        local humanoid = getHumanoid(player)
        if humanoid then humanoid.WalkSpeed = speed end

    elseif action == "ResetSpeed" then
        speedSaved[player] = 16
        local humanoid = getHumanoid(player)
        if humanoid then humanoid.WalkSpeed = 16 end

    elseif action == "NoClip" then
        if typeof(value) ~= "boolean" then return end
        applyNoclip(player, value)

    elseif action == "Fly" then
        if typeof(value) ~= "boolean" then return end
        player:SetAttribute("KATIO_FlyEnabled", value)

    elseif action == "InfiniteJump" then
        if typeof(value) ~= "boolean" then return end
        player:SetAttribute("KATIO_InfiniteJump", value)

    -- OWNER KEY: solo el usuario OWNER puede desbloquearlo
    elseif action == "UnlockOwner" then
        if role ~= "OWNER" then return end
        if value == OWNER_KEY then
            player:SetAttribute("KATIO_OwnerUnlocked", true)
            remote:FireClient(player, "OwnerUnlocked")
        else
            remote:FireClient(player, "OwnerKeyInvalid")
        end

    -- OWNER POWERS
    elseif action == "OwnerPower" then
        if role ~= "OWNER" or player:GetAttribute("KATIO_OwnerUnlocked") ~= true then
            return
        end

        if value == "InvincibleOn" then
            applyInvincible(player, true)
        elseif value == "InvincibleOff" then
            applyInvincible(player, false)
        elseif value == "InvisibleOn" then
            applyInvisible(player, true)
        elseif value == "InvisibleOff" then
            applyInvisible(player, false)
        elseif value == "SuperSpeedOn" then
            speedSaved[player] = 100
            local humanoid = getHumanoid(player)
            if humanoid then humanoid.WalkSpeed = 100 end
        elseif value == "SuperSpeedOff" then
            speedSaved[player] = 16
            local humanoid = getHumanoid(player)
            if humanoid then humanoid.WalkSpeed = 16 end
        elseif value == "TeleportNearest" then
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if not root then return end

            local nearestRoot
            local nearestDistance = math.huge

            for _, other in ipairs(Players:GetPlayers()) do
                if other ~= player and other.Character then
                    local otherRoot = other.Character:FindFirstChild("HumanoidRootPart")
                    local otherHumanoid = getHumanoid(other)

                    if otherRoot and otherHumanoid and otherHumanoid.Health > 0 then
                        local distance = (root.Position - otherRoot.Position).Magnitude
                        if distance < nearestDistance then
                            nearestDistance = distance
                            nearestRoot = otherRoot
                        end
                    end
                end
            end

            if nearestRoot then
                root.CFrame = nearestRoot.CFrame * CFrame.new(0, 0, -4)
            end
        end
    end
end)

-- Mantiene el NoClip aplicado también a piezas nuevas del personaje
RunService.Heartbeat:Connect(function()
    for player, enabled in pairs(noclip) do
        if enabled and player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    collisionSaved[player] = collisionSaved[player] or {}
                    if collisionSaved[player][part] == nil then
                        collisionSaved[player][part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    noclip[player] = nil
    collisionSaved[player] = nil
    transparencySaved[player] = nil
    invincible[player] = nil
    invisible[player] = nil
    speedSaved[player] = nil
end)
