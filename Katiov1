local function corner(obj)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 9)
    c.Parent = obj
end

local function outline(obj)
    local s = Instance.new("UIStroke")
    s.Color = PURPLE
    s.Thickness = 1.5
    s.Parent = obj
end

local function label(parent, text, size, pos, fontSize)
    local l = Instance.new("TextLabel")
    l.Parent = parent
    l.BackgroundTransparency = 1
    l.Size = size
    l.Position = pos
    l.Text = text
    l.TextColor3 = WHITE
    l.Font = Enum.Font.GothamBold
    l.TextSize = fontSize or 14
    l.TextWrapped = true
    return l
end

local function button(parent, text, size, pos)
    local b = Instance.new("TextButton")
    b.Parent = parent
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = CARD
    b.Text = text
    b.TextColor3 = WHITE
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.AutoButtonColor = true
    corner(b)
    outline(b)
    return b
end

local function textbox(parent, hint, size, pos)
    local t = Instance.new("TextBox")
    t.Parent = parent
    t.Size = size
    t.Position = pos
    t.BackgroundColor3 = CARD
    t.TextColor3 = WHITE
    t.PlaceholderColor3 = Color3.fromRGB(180, 170, 190)
    t.PlaceholderText = hint
    t.Font = Enum.Font.Gotham
    t.TextSize = 14
    t.ClearTextOnFocus = false
    corner(t)
    outline(t)
    return t
end

local function draggable(frame, handle)
    local dragging = false
    local startInput, startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPosition = frame.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - startInput
            frame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

