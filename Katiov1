--========================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local OWNER_NAME = "MINIDELTAX8"
local ADMIN_NAME = "Lewis_t480"

local Remote = Instance.new("RemoteEvent")
Remote.Name = "KATIO_AdminRemote"
Remote.Parent = ReplicatedStorage

local Roles = {}

local function setupPlayer(player)
    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(player.Name)
    end)

    if not success then return end

    if player.Name:lower() == OWNER_NAME:lower() then
        Roles[player.UserId] = "OWNER"
    elseif player.Name:lower() == ADMIN_NAME:lower() then
        Roles[player.UserId] = "ADMIN"
    else
        Roles[player.UserId] = nil
    end

    player:SetAttribute("KATIO_Role", Roles[player.UserId] or "USER")
end

Players.PlayerAdded:Connect(setupPlayer)

for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(setupPlayer, player)
end

local function authorized(player)
    return Roles[player.UserId] == "OWNER"
        or Roles[player.UserId] == "ADMIN"
end

local function setSpeed(player, enabled)
    local humanoid = player.Character
        and player.Character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = enabled and 32 or 16
    end
end

local function setNoclip(player, enabled)
    local character = player.Character
    if not character then return end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if enabled then
                if part:GetAttribute("KATIO_OldCollision") == nil then
                    part:SetAttribute("KATIO_OldCollision", part.CanCollide)
                end
                part.CanCollide = false
            else
                local old = part:GetAttribute("KATIO_OldCollision")
                if old ~= nil then
                    part.CanCollide = old
                    part:SetAttribute("KATIO_OldCollision", nil)
                end
            end
        end
    end
end

Remote.OnServerEvent:Connect(function(player, action, enabled)
    if not authorized(player) then return end
    if typeof(enabled) ~= "boolean" then return end

    if action == "Speed" then
        setSpeed(player, enabled)

    elseif action == "NoClip" then
        setNoclip(player, enabled)

    elseif action == "Fly" then
        player:SetAttribute("KATIO_FlyEnabled", enabled)

    elseif action == "InfiniteJump" then
        player:SetAttribute("KATIO_InfiniteJump", enabled)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    Roles[player.UserId] = nil
end)

print("KATIO ADMIN SERVER READY")
