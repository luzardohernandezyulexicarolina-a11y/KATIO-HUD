    create("TextLabel",{
        Size=UDim2.new(1,-90,1,0),
        Position=UDim2.new(0,14,0,0),
        BackgroundTransparency=1,
        Text=label,
        TextColor3=Color3.new(1,1,1),
        Font=Enum.Font.GothamBold,
        TextSize=15,
        TextXAlignment=Enum.TextXAlignment.Left
    },row)

    local active=false
    local button=create("TextButton",{
        Size=UDim2.new(0,55,0,29),
        Position=UDim2.new(1,-65,.5,-14),
        BackgroundColor3=Color3.fromRGB(65,60,75),
        Text="OFF",
        TextColor3=Color3.new(1,1,1),
        Font=Enum.Font.GothamBold,
        TextSize=12
    },row)
    corner(button,20)

    button.MouseButton1Click:Connect(function()
        active=not active
        button.Text=active and "ON" or "OFF"
        button.BackgroundColor3=active and purple
            or Color3.fromRGB(65,60,75)
        callback(active)
    end)
end

