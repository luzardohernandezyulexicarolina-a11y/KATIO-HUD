-- Fly
local flying=false
local flySpeed=65
local flyUp=false
local flyDown=false
local velocity, gyro, flyConnection

local function stopFly()
    flying=false
    if flyConnection then flyConnection:Disconnect() flyConnection=nil end
    if velocity then velocity:Destroy() velocity=nil end
    if gyro then gyro:Destroy() gyro=nil end
end

local function startFly()
    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local h=getHumanoid()
    if not root or not h then return end

    stopFly()
    flying=true
    velocity=Instance.new("BodyVelocity")
    velocity.MaxForce=Vector3.new(1e6,1e6,1e6)
    velocity.Parent=root

    gyro=Instance.new("BodyGyro")
    gyro.MaxTorque=Vector3.new(1e6,1e6,1e6)
    gyro.P=9000
    gyro.Parent=root

    flyConnection=RunService.RenderStepped:Connect(function()
        if not root.Parent then stopFly() return end
        local camera=workspace.CurrentCamera
        local direction=h.MoveDirection
        local vertical=(flyUp and 1 or 0)-(flyDown and 1 or 0)
        velocity.Velocity=direction*flySpeed+
            Vector3.new(0,vertical*flySpeed,0)
        gyro.CFrame=camera.CFrame
    end)
end

toggle(playerPage,"🪽 Fly",function(on)
    if on then startFly() else stopFly() end
end)

